# ===================================================================
# ReadWise AI — משתני סביבה
# העתק/י קובץ זה ל-.env.local ומלא/י את הערכים האמיתיים.
# חשוב: אף מפתח כאן לא מגיע ל-client. משתנים שחייבים להיות זמינים
# בדפדפן מסומנים במפורש (NEXT_PUBLIC_*) — כל היתר נשארים server-side בלבד.
# ===================================================================

# --- Supabase (חובה) ---
# מהגדרות הפרויקט ב-supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# מפתח service_role — שימוש בשרת בלבד (Server Actions / Route Handlers), אף פעם לא ב-client!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic (Claude) — חובה עבור כל יכולות ה-AI ---
# https://console.anthropic.com/settings/keys
# שימוש בשרת בלבד, דרך lib/ai/*
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
