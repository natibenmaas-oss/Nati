# ===================================================================
# ReadWise AI — משתני סביבה
# העתק/י קובץ זה ל-.env.local ומלא/י את הערכים האמיתיים.
# חשוב: אף מפתח כאן לא מגיע ל-client. משתנים שחייבים להיות זמינים
# בדפדפן מסומנים במפורש (NEXT_PUBLIC_*) — כל היתר נשארים server-side בלבד.
# ===================================================================

# --- Supabase (חובה) ---
# מהגדרות הפרויקט ב-supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# מפתח service_role — שימוש בשרת בלבד (Server Actions / Route Handlers), אף פעם לא ב-client!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic (Claude) — חובה עבור כל יכולות ה-AI ---
# https://console.anthropic.com/settings/keys
# שימוש בשרת בלבד, דרך lib/ai/*
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# אופציונלי: שינוי המודל שבו משתמשת המערכת (ברירת מחדל: claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5

# --- זריעת נתוני דמו מרחוק (אופציונלי) ---
# סוד שרירותי משלך (מחרוזת אקראית ארוכה) שמאפשר להריץ פעם אחת את
# GET /api/admin/seed-demo?secret=<הסוד הזה> על השרת המופרס, ליצירת מורה
# דמו + כיתה + 8 תלמידים + טקסטים + נתוני קריאה היסטוריים. שימושי כשאין
# גישת רשת ישירה מסביבת הפיתוח למסד הנתונים החי. אל תשתפו את הסוד הזה.
# SEED_ADMIN_SECRET=change-me-to-a-long-random-string
